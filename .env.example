# Copy to .env and replace every CHANGE_ME value before running Docker Compose.
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

POSTGRES_USER=wolloyewa
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=wolloyewa
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://wolloyewa:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/wolloyewa

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_HOST_PORT=6380
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_URL=https://store.example
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_WEBHOOK_SECRET
ADMIN_IDS=CHANGE_ME_ADMIN_ID
WEB_APP_URL=https://store.example/app/
APP_UID=1000
APP_GID=1000
DEV_FAKE_PAYMENT=False
DEV_POPULATE_DUMMY_DATA=False
DEV_SKIP_MIDDLEWARES=False
RATE_LIMIT_ENABLED=True

SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENCRYPTION_KEY=CHANGE_ME_WITH_A_VALID_FERNET_KEY
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
CBE_BIRR_MERCHANT_ID=
CBE_BIRR_TERMINAL_ID=
CBE_BIRR_SECRET_KEY=

CORS_ALLOWED_ORIGINS=["https://store.example"]
ALLOWED_HOSTS=["store.example","localhost","app"]

GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_FLOWER_PASSWORD
